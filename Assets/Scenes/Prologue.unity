MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 945532947}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 237d0065eb4827c4c929bfb3cfde1a8c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StartDialogue
  dialogueLines:
  - speakerName: Huayla
    dialogueText: "\xA1Chaco! \xBFbuenos d\xEDas, ya viste quienes llegaron?"
    speakerPortrait: {fileID: 21300000, guid: 124d0740729f33346b5972e01dfc6758, type: 3}
    speakerID: 0
  - speakerName: Chaco
    dialogueText: "\xA1Como estas Huayla! son la liga llego a ver que traen."
    speakerPortrait: {fileID: 21300000, guid: 85d9da18cc27b5b4faba395cf4b813a6, type: 3}
    speakerID: 1
  - speakerName: Huayla
    dialogueText: "Espera te est\xE1n buscando para que ayudes con unas cosas."
    speakerPortrait: {fileID: 21300000, guid: 124d0740729f33346b5972e01dfc6758, type: 3}
    speakerID: 0
  - speakerName: Chaco
    dialogueText: Pero yo quiero ir a pedirles a los mercaderes que me lleven en
      la otra salida
    speakerPortrait: {fileID: 21300000, guid: 85d9da18cc27b5b4faba395cf4b813a6, type: 3}
    speakerID: 1
  - speakerName: Huayla
    dialogueText: Ellos solo llevan a gente que sabe hacer oficio, mejor anda a lo
      que te encomendaron.
    speakerPortrait: {fileID: 21300000, guid: 124d0740729f33346b5972e01dfc6758, type: 3}
    speakerID: 0
  - speakerName: Huayla
    dialogueText: Luego me regreso a pedirles que lleven.
    speakerPortrait: {fileID: 21300000, guid: 124d0740729f33346b5972e01dfc6758, type: 3}
    speakerID: 0
